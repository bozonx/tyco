{
  "name": "@tyco/plugin-fast-note",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./templates": {
      "types": "./dist/fast-note-template.d.ts",
      "default": "./dist/fast-note-template.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tyco-plugin-build",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@tyco/plugin-sdk": "workspace:^"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@tyco/plugin-build": "workspace:^",
    "@vitest/coverage-v8": "catalog:"
  }
}
