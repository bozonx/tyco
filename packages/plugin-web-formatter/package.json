{
  "name": "@tyco/plugin-web-formatter",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tyco-plugin-build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@tyco/plugin-sdk": "workspace:^",
    "@prettier/plugin-xml": "^3.4.2",
    "highlight.js": "^11.12.0",
    "prettier": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@tyco/plugin-build": "workspace:^"
  }
}
