  "commands": [
    {
      "id": "reply-draft",
      "name": "Draft a reply",
      "description": "Drafts a reply to the selected message.",
      "phrases": [],
      "isVoiceEnabled": false,
      "toolId": "core.aiTask",
      "toolConfig": {
        "prompt": "Input: a message the user received (an email or a chat message).\n\nTask: write the user's reply to it.\n- Answer every question and request in the message.\n- Where the user must decide something, leave a placeholder such as [date] or [yes/no].\n- Match the formality of the message.\n\nOutput: the reply text only, ready to send, in the language of the message.",
        "allowedCommandIds": [],
        "maxSteps": 5
      },
      "isLlmArgumentParsingEnabled": false,
      "isLlmPreTransformEnabled": false,
      "llmPreTransformPrompt": "",
      "outputAction": "showMenu",
      "isOutputLogged": false,
      "isAvailableExternally": false,
      "externalTimeoutSec": 120,
      "isEnabled": true
    }
  ],
  "variables": [],
  "variableValues": {},
