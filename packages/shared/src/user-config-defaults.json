  "transformations": {
    "items": [
      {
        "id": "deep-edit",
        "name": "Deep edit",
        "rule": "Input: a draft written in a hurry; it may be wordy or clumsy.\n\nTask:\n- Rephrase awkward sentences so they read naturally.\n- Remove repetition and filler words.\n- Add missing words (pronouns, connectors) where the meaning needs them.\n\nKeep: the meaning, facts, tone and language of the draft. Add no new ideas.\n\nOutput: the edited text only, no longer than the draft."
      }
    ],
    "slots": { "q": "deep-edit" }
  },
  "styling": {
    "items": [
      {
        "id": "business",
        "name": "Business",
        "rule": "Style: polite, professional business correspondence.\n\n- A neutral, respectful tone; no slang, jokes or emoji.\n- Short, clear sentences; the main point first.\n- Keep the greeting and closing if the text has them; do not add new ones.\n\nOutput: the restyled text only, in the language of the original."
      }
    ],
    "slots": { "q": "business" }
  },
  "chatPrompts": {
    "isSentImmediately": false,
    "items": [
      {
        "id": "explain",
        "name": "Explain simply",
        "profileId": "",
        "rule": "Input: the text or question below.\n\nTask: explain it in plain words to someone new to the topic.\n\nOutput:\n- One sentence with the main idea.\n- Three to five bullet points with the key details.\n- A short everyday example, if it helps.\n\nAnswer in the language of the input."
      }
    ]
  },
  "favorites": { "items": [] },
  "aiVault": { "path": "" },
  "aiProfiles": { "chatHistory": { "storage": "disk" } },
