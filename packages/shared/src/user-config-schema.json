{
  "type": "object",
  "properties": {
    "submitKey": { "enum": ["enter", "ctrlEnter"], "defaultPath": "submitKey" },
    "quickCorrectionPrefetch": {
      "type": "boolean",
      "defaultPath": "quickCorrectionPrefetch"
    },
    "quickHideOnBlur": { "type": "boolean", "defaultPath": "quickHideOnBlur" },
    "appLanguage": { "type": "string", "defaultPath": "appLanguage" },
    "userLanguage": { "type": "string", "defaultPath": "userLanguage" },
    "diffViewMode": {
      "enum": ["unified", "split", "result"],
      "defaultPath": "diffViewMode"
    },
    "configVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "configVersion"
    },
    "hotkeys": {
      "type": "object",
      "properties": {
        "editor": { "type": "string", "default": "" },
        "write": { "type": "string", "default": "" },
        "chat": { "type": "string", "default": "" },
        "voiceChat": { "type": "string", "default": "" },
        "voice": { "type": "string", "default": "Ctrl+Alt+V" },
        "select": { "type": "string", "default": "Ctrl+Alt+S" },
        "aiTasks": { "type": "string", "default": "" },
        "commandLauncher": { "type": "string", "default": "" },
        "commandLauncher2": { "type": "string", "default": "" },
        "commandLauncher3": { "type": "string", "default": "" },
        "commandLauncher4": { "type": "string", "default": "" },
        "commandLauncher5": { "type": "string", "default": "" },
        "correction": { "type": "string", "default": "" },
        "translate": { "type": "string", "default": "" },
        "voiceCommands": { "type": "string", "default": "" }
      },
      "required": [
        "editor",
        "write",
        "chat",
        "voiceChat",
        "voice",
        "select",
        "aiTasks",
        "commandLauncher",
        "commandLauncher2",
        "commandLauncher3",
        "commandLauncher4",
        "commandLauncher5",
        "correction",
        "translate",
        "voiceCommands"
      ],
      "additionalProperties": false,
      "defaultPath": "hotkeys"
    },
    "selectionHotkeys": {
      "type": "object",
      "properties": { "correction": { "type": "string", "default": "" } },
      "required": [],
      "additionalProperties": false,
      "defaultPath": "selectionHotkeys"
    },
    "externalAccess": {
      "type": "object",
      "properties": { "selection": { "type": "boolean", "default": false } },
      "required": ["selection"],
      "additionalProperties": false,
      "defaultPath": "externalAccess"
    },
    "windowInsertion": {
      "type": "object",
      "properties": {
        "method": { "enum": ["xdotool", "ydotool"], "default": "xdotool" },
        "xdotoolBin": { "type": "string", "default": "" },
        "ydotoolBin": { "type": "string", "default": "" },
        "pasteShortcut": {
          "enum": ["ctrl+v", "ctrl+shift+v", "shift+insert"],
          "default": "ctrl+v"
        }
      },
      "required": ["method", "xdotoolBin", "ydotoolBin", "pasteShortcut"],
      "additionalProperties": false,
      "defaultPath": "windowInsertion"
    },
    "mainActions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["standard"] },
              "actionId": {
                "enum": [
                  "insertIntoWindow",
                  "copyToClipboard",
                  "aiTask",
                  "correction",
                  "translation",
                  "askInChat"
                ],
                "default": "insertIntoWindow"
              }
            },
            "required": ["type", "actionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["plugin"] },
              "actionId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "actionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["command"] },
              "commandId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "commandId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["aiTask"] },
              "taskId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "taskId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["translation"] },
              "language": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "language"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["launcherPage"] },
              "pageId": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "pageId"],
            "additionalProperties": false
          },
          { "type": "null" }
        ]
      },
      "defaultPath": "mainActions"
    },
    "launcherPages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slots": {
            "type": "array",
            "minItems": 15,
            "maxItems": 15,
            "items": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            },
            "default": [
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null,
              null
            ]
          },
          "inputMode": { "enum": ["selection", "none"], "default": "selection" }
        },
        "required": ["id", "slots", "inputMode"],
        "additionalProperties": false
      },
      "defaultPath": "launcherPages"
    },
    "translation": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["deepl", "google", "llm"], "default": "llm" },
        "qualityGate": {
          "enum": ["off", "onProblems", "always"],
          "default": "off"
        },
        "deeplEndpoint": { "enum": ["free", "pro"], "default": "free" },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string", "default": "", "minLength": 1 },
              "use": { "type": "string", "default": "" },
              "doNotTranslate": { "type": "boolean", "default": false }
            },
            "required": ["term", "use", "doNotTranslate"],
            "additionalProperties": false
          },
          "default": []
        },
        "correctionPrompt": { "type": "string", "default": "" },
        "targetLanguages": {
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string", "default": "" }, { "type": "null" }],
            "default": null
          },
          "default": ["en_US"]
        },
        "viewMode": { "enum": ["split", "result"], "default": "split" }
      },
      "required": [
        "provider",
        "qualityGate",
        "deeplEndpoint",
        "glossary",
        "correctionPrompt",
        "targetLanguages",
        "viewMode"
      ],
      "additionalProperties": false,
      "defaultPath": "translation"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "default": "", "minLength": 1 },
          "name": { "type": "string", "default": "" },
          "description": { "type": "string", "default": "" },
          "phrases": {
            "type": "array",
            "items": { "type": "string", "default": "" },
            "default": []
          },
          "toolId": { "type": "string", "default": "", "minLength": 1 },
          "toolConfig": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "isLlmArgumentParsingEnabled": {
            "type": "boolean",
            "default": false
          },
          "launcherAfterRun": {
            "type": "object",
            "properties": {
              "action": {
                "enum": ["none", "showMenu", "insertIntoWindow", "copy"],
                "default": "none"
              }
            },
            "required": ["action"],
            "additionalProperties": false
          },
          "logOutput": { "type": "boolean", "default": false },
          "availableIn": {
            "type": "object",
            "properties": {
              "external": { "type": "boolean", "default": false },
              "chat": { "type": "boolean", "default": false }
            },
            "required": ["external", "chat"],
            "additionalProperties": false
          },
          "enabled": { "type": "boolean", "default": true },
          "isVoiceEnabled": { "type": "boolean", "default": false },
          "voiceConfirmation": {
            "enum": ["always", "auto"],
            "default": "always"
          }
        },
        "required": [
          "id",
          "name",
          "phrases",
          "toolId",
          "toolConfig",
          "isLlmArgumentParsingEnabled",
          "launcherAfterRun",
          "logOutput",
          "availableIn",
          "enabled",
          "isVoiceEnabled",
          "voiceConfirmation"
        ],
        "additionalProperties": false
      },
      "defaultPath": "commands"
    },
    "registrationState": {
      "type": "object",
      "properties": {
        "reviewedMainActionIds": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": [],
          "uniqueItems": true
        },
        "seededCommandIds": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": [],
          "uniqueItems": true
        },
        "seededToolIds": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": [],
          "uniqueItems": true
        }
      },
      "required": [
        "reviewedMainActionIds",
        "seededCommandIds",
        "seededToolIds"
      ],
      "additionalProperties": false,
      "defaultPath": "registrationState"
    },
    "llm": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "maxLength": 64
              },
              "type": {
                "enum": [
                  "google",
                  "openrouter",
                  "deepseek",
                  "openai-compatible"
                ],
                "default": "google"
              },
              "name": { "type": "string", "default": "" },
              "baseUrl": { "type": "string", "default": "" }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "default": "", "minLength": 1 },
              "providerId": { "type": "string", "default": "", "minLength": 1 },
              "providerModelId": { "type": "string", "default": "" },
              "name": { "type": "string", "default": "" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "contextWindowTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canUseImages": { "type": "boolean", "default": false },
              "canUseTools": { "type": "boolean", "default": false },
              "isThinkingEnabled": { "type": "boolean", "default": false }
            },
            "required": ["id", "providerId", "providerModelId"],
            "additionalProperties": false
          },
          "default": []
        },
        "taskModelChains": {
          "type": "object",
          "properties": {
            "translate": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "voiceCorrection": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "correction": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "aiTasks": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            }
          },
          "required": ["translate", "voiceCorrection", "correction", "aiTasks"],
          "additionalProperties": false
        }
      },
      "required": ["providers", "models", "taskModelChains"],
      "additionalProperties": false,
      "defaultPath": "llm"
    },
    "aiRules": {
      "type": "object",
      "properties": {
        "chat": { "type": "string", "default": "" },
        "correction": { "type": "string", "default": "" },
        "translate": { "type": "string", "default": "" },
        "voiceCorrection": { "type": "string", "default": "" }
      },
      "required": ["chat", "correction", "translate", "voiceCorrection"],
      "additionalProperties": false,
      "defaultPath": "aiRules"
    },
    "aiTasks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": { "type": "string", "default": "", "minLength": 1 },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"],
            "additionalProperties": false
          },
          { "type": "null" }
        ],
        "default": null
      },
      "defaultPath": "aiTasks"
    },
    "plugins": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true,
      "defaultPath": "plugins"
    },
    "aiProfiles": {
      "type": "object",
      "properties": { "vaultPath": { "type": "string" } },
      "additionalProperties": false,
      "default": {}
    },
    "markdown": {
      "type": "object",
      "properties": {
        "bullet": { "enum": ["-", "*", "+"], "default": "-" },
        "emphasis": { "enum": ["*", "_"], "default": "*" },
        "strong": { "enum": ["*", "_"], "default": "*" },
        "headingStyle": { "enum": ["atx", "setext"], "default": "atx" },
        "incrementListMarker": { "type": "boolean", "default": true }
      },
      "required": [
        "bullet",
        "emphasis",
        "strong",
        "headingStyle",
        "incrementListMarker"
      ],
      "additionalProperties": false,
      "defaultPath": "markdown"
    },
    "markdownClean": {
      "type": "object",
      "properties": {
        "bullet": { "enum": ["-", "*", "none"], "default": "-" },
        "codeBlockIndent": {
          "enum": ["none", "2spaces", "4spaces", "tab"],
          "default": "none"
        },
        "blockquoteIndent": {
          "enum": ["none", "2spaces", "4spaces", "tab", "angle"],
          "default": "none"
        },
        "keepInlineCode": { "type": "boolean", "default": false },
        "linkFormat": {
          "enum": ["text", "textAndUrl", "url"],
          "default": "text"
        },
        "imageFormat": {
          "enum": ["alt", "altAndUrl", "url", "none"],
          "default": "alt"
        },
        "keepThematicBreaks": { "type": "boolean", "default": true },
        "keepTaskCheckboxes": { "type": "boolean", "default": true }
      },
      "required": [
        "bullet",
        "codeBlockIndent",
        "blockquoteIndent",
        "keepInlineCode",
        "linkFormat",
        "imageFormat",
        "keepThematicBreaks",
        "keepTaskCheckboxes"
      ],
      "additionalProperties": false,
      "defaultPath": "markdownClean"
    },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": ["auto", "light", "dark", "e-ink"],
          "default": "auto"
        },
        "contrast": { "enum": ["auto", "normal", "more"], "default": "auto" },
        "motion": { "enum": ["auto", "normal", "reduce"], "default": "auto" },
        "uiScale": { "enum": [100, 115, 130, 150, 175, 200], "default": 100 }
      },
      "required": ["theme", "contrast", "motion", "uiScale"],
      "additionalProperties": false,
      "defaultPath": "appearance"
    },
    "editorHistory": {
      "type": "object",
      "properties": {
        "storage": { "enum": ["off", "session", "disk"], "default": "disk" },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 1000
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 30
        },
        "sanitizeSecrets": { "type": "boolean", "default": true }
      },
      "required": ["storage", "maxItems", "retentionDays", "sanitizeSecrets"],
      "additionalProperties": false,
      "defaultPath": "editorHistory"
    },
    "chat": {
      "type": "object",
      "properties": {
        "imageQuality": {
          "enum": ["economy", "balanced", "original"],
          "default": "balanced"
        },
        "isHistoryEnabled": { "type": "boolean", "default": true },
        "historyRetentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        }
      },
      "required": ["imageQuality", "isHistoryEnabled", "historyRetentionDays"],
      "additionalProperties": false,
      "defaultPath": "chat"
    },
    "stt": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "default": "", "minLength": 1 },
              "providerModelId": { "type": "string", "default": "" },
              "provider": {
                "enum": ["deepgram", "sherpa-onnx"],
                "default": "deepgram"
              },
              "description": { "type": "string", "default": "" },
              "formatWithLlm": { "type": "boolean", "default": false },
              "language": { "type": "string", "default": "" },
              "baseUrl": { "type": "string", "default": "" }
            },
            "required": ["id", "providerModelId", "provider"],
            "additionalProperties": false
          },
          "default": [
            {
              "id": "deepgram-stt",
              "provider": "deepgram",
              "description": "Deepgram speech recognition",
              "formatWithLlm": false,
              "language": "auto",
              "providerModelId": "nova-3"
            },
            {
              "id": "sherpa-onnx-stt",
              "provider": "sherpa-onnx",
              "description": "Self-hosted sherpa-onnx streaming server",
              "formatWithLlm": false,
              "baseUrl": "ws://localhost:6006",
              "providerModelId": "sherpa-onnx"
            }
          ],
          "minItems": 1
        },
        "selectedModelId": { "type": "string", "default": "deepgram-stt" }
      },
      "required": ["models", "selectedModelId"],
      "additionalProperties": false,
      "defaultPath": "stt"
    }
  },
  "required": [
    "externalAccess",
    "hotkeys",
    "selectionHotkeys",
    "submitKey",
    "quickCorrectionPrefetch",
    "quickHideOnBlur",
    "windowInsertion",
    "appLanguage",
    "userLanguage",
    "translation",
    "mainActions",
    "commands",
    "llm",
    "aiRules",
    "aiTasks",
    "markdown",
    "markdownClean",
    "plugins",
    "registrationState",
    "diffViewMode",
    "configVersion",
    "appearance",
    "editorHistory",
    "chat",
    "stt",
    "launcherPages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyco user configuration",
  "$defs": {
    "scriptToolConfig": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "default": "" },
        "workingDirectory": { "type": "string", "default": "" },
        "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "webhookToolConfig": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "default": "" },
        "method": { "enum": ["GET", "POST"], "default": "POST" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "payloadTemplate": { "type": "string", "default": "" },
        "isAuthEnabled": { "type": "boolean", "default": false },
        "authSecretId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    }
  }
}
