{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyco user configuration",
  "type": "object",
  "properties": {
    "isInDevelopment": { "type": "boolean", "x-scope": "device" },
    "configVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "configVersion"
    },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": ["auto", "light", "dark", "eInk"],
          "default": "auto"
        },
        "contrast": { "enum": ["auto", "normal", "more"], "default": "auto" },
        "motion": { "enum": ["auto", "normal", "reduce"], "default": "auto" },
        "uiScalePercent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 300,
          "default": 100,
          "x-scope": "device"
        }
      },
      "required": ["theme", "contrast", "motion", "uiScalePercent"],
      "defaultPath": "appearance"
    },
    "language": {
      "type": "object",
      "properties": {
        "ui": { "type": "string", "default": "auto", "minLength": 1 }
      },
      "required": ["ui"],
      "additionalProperties": false,
      "defaultPath": "language"
    },
    "editor": {
      "type": "object",
      "properties": {
        "submitKey": { "enum": ["Enter", "Ctrl+Enter"], "default": "Enter" },
        "diffViewMode": {
          "enum": ["unified", "split", "result", "original"],
          "default": "unified"
        },
        "history": {
          "type": "object",
          "properties": {
            "storage": {
              "enum": ["off", "session", "disk"],
              "default": "disk"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1000
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "isSecretSanitizingEnabled": { "type": "boolean", "default": true },
            "isLocalOnly": {
              "type": "boolean",
              "default": false,
              "x-scope": "device"
            }
          },
          "required": [
            "storage",
            "maxItems",
            "isSecretSanitizingEnabled",
            "isLocalOnly"
          ],
          "default": {
            "storage": "disk",
            "maxItems": 1000,
            "retentionDays": 30,
            "isSecretSanitizingEnabled": true,
            "isLocalOnly": false
          }
        },
        "shortcuts": {
          "type": "object",
          "properties": {
            "bold": { "type": "string", "default": "Ctrl+B" },
            "italic": { "type": "string", "default": "Ctrl+I" },
            "link": { "type": "string", "default": "Ctrl+K" },
            "code": { "type": "string", "default": "Ctrl+E" },
            "strikethrough": { "type": "string", "default": "Ctrl+Shift+X" },
            "normalText": { "type": "string", "default": "Ctrl+0" },
            "heading1": { "type": "string", "default": "Ctrl+1" },
            "heading2": { "type": "string", "default": "Ctrl+2" },
            "heading3": { "type": "string", "default": "Ctrl+3" },
            "heading4": { "type": "string", "default": "" },
            "heading5": { "type": "string", "default": "" },
            "heading6": { "type": "string", "default": "" },
            "bulletList": { "type": "string", "default": "Ctrl+Shift+8" },
            "orderedList": { "type": "string", "default": "Ctrl+Shift+7" },
            "taskList": { "type": "string", "default": "Ctrl+Shift+9" },
            "quote": { "type": "string", "default": "Ctrl+Shift+Period" },
            "indent": { "type": "string", "default": "Tab" },
            "outdent": { "type": "string", "default": "Shift+Tab" },
            "toggleMarkup": { "type": "string", "default": "Ctrl+Shift+M" }
          },
          "required": [
            "bold",
            "italic",
            "link",
            "code",
            "strikethrough",
            "normalText",
            "heading1",
            "heading2",
            "heading3",
            "heading4",
            "heading5",
            "heading6",
            "bulletList",
            "orderedList",
            "taskList",
            "quote",
            "indent",
            "outdent",
            "toggleMarkup"
          ],
          "additionalProperties": false,
          "defaultPath": "editor.shortcuts"
        }
      },
      "required": ["submitKey", "diffViewMode", "history", "shortcuts"],
      "defaultPath": "editor"
    },
    "quickWindow": {
      "type": "object",
      "properties": {
        "isHiddenOnBlur": { "type": "boolean", "default": true },
        "isCorrectionPrefetchEnabled": { "type": "boolean", "default": false },
        "correctionMode": {
          "type": "string",
          "enum": ["live", "onSubmit", "off"],
          "default": "onSubmit"
        }
      },
      "required": [
        "isHiddenOnBlur",
        "isCorrectionPrefetchEnabled",
        "correctionMode"
      ],
      "defaultPath": "quickWindow"
    },
    "hotkeys": {
      "type": "object",
      "properties": {
        "editor": { "type": "string", "default": "" },
        "quickInput": { "type": "string", "default": "Ctrl+Alt+Shift+W" },
        "chat": { "type": "string", "default": "" },
        "voiceChat": { "type": "string", "default": "" },
        "voice": { "type": "string", "default": "Ctrl+Alt+Shift+V" },
        "selectionActions": { "type": "string", "default": "Ctrl+Alt+Shift+S" },
        "correction": { "type": "string", "default": "" },
        "translation": { "type": "string", "default": "" },
        "styling": { "type": "string", "default": "" },
        "transformation": { "type": "string", "default": "" },
        "customTransformation": { "type": "string", "default": "" },
        "voiceTransformation": { "type": "string", "default": "" },
        "chatPrompts": { "type": "string", "default": "" },
        "snippets": { "type": "string", "default": "" },
        "history": { "type": "string", "default": "" },
        "voiceCommands": { "type": "string", "default": "Ctrl+Alt+Shift+X" },
        "selectionCorrection": {
          "type": "string",
          "default": "Ctrl+Alt+Shift+F"
        },
        "selectionActionsPage2": { "type": "string", "default": "" },
        "selectionActionsPage3": { "type": "string", "default": "" },
        "selectionActionsPage4": { "type": "string", "default": "" },
        "selectionActionsPage5": { "type": "string", "default": "" }
      },
      "required": [
        "editor",
        "quickInput",
        "chat",
        "voiceChat",
        "voice",
        "selectionActions",
        "selectionActionsPage2",
        "selectionActionsPage3",
        "selectionActionsPage4",
        "selectionActionsPage5",
        "correction",
        "translation",
        "styling",
        "transformation",
        "customTransformation",
        "voiceTransformation",
        "chatPrompts",
        "snippets",
        "history",
        "voiceCommands",
        "selectionCorrection"
      ],
      "defaultPath": "hotkeys",
      "x-scope": "device"
    },
    "externalAccess": {
      "type": "object",
      "properties": {
        "canAccessSelection": { "type": "boolean", "default": false }
      },
      "required": ["canAccessSelection"],
      "defaultPath": "externalAccess",
      "x-scope": "device"
    },
    "windowInsertion": {
      "type": "object",
      "properties": {
        "linux": {
          "type": "object",
          "properties": {
            "pasteShortcut": {
              "enum": ["Ctrl+V", "Ctrl+Shift+V", "Shift+Insert"],
              "default": "Ctrl+V"
            },
            "terminalPasteShortcut": {
              "enum": [null, "Ctrl+V", "Ctrl+Shift+V", "Shift+Insert"],
              "default": "Ctrl+Shift+V"
            }
          },
          "required": ["pasteShortcut", "terminalPasteShortcut"],
          "additionalProperties": false,
          "default": {
            "pasteShortcut": "Ctrl+V",
            "terminalPasteShortcut": "Ctrl+Shift+V"
          }
        },
        "terminalApps": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": []
        }
      },
      "required": ["linux", "terminalApps"],
      "defaultPath": "windowInsertion",
      "x-scope": "device"
    },
    "translation": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["deepl", "google", "llm"], "default": "llm" },
        "providers": {
          "type": "object",
          "properties": {
            "deepl": {
              "type": "object",
              "properties": {
                "endpoint": { "enum": ["free", "pro"], "default": "free" }
              },
              "required": ["endpoint"],
              "default": { "endpoint": "free" }
            }
          },
          "required": ["deepl"],
          "default": { "deepl": { "endpoint": "free" } }
        },
        "qualityGate": {
          "enum": ["off", "onProblems", "always"],
          "default": "off"
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string", "default": "", "minLength": 1 },
              "translation": { "type": "string", "default": "" },
              "translations": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                },
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["term", "translation"]
          },
          "default": []
        },
        "targetLanguages": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": { "q": "en-US" }
        },
        "viewMode": { "enum": ["split", "result"], "default": "split" }
      },
      "required": [
        "provider",
        "providers",
        "qualityGate",
        "glossary",
        "targetLanguages",
        "viewMode"
      ],
      "defaultPath": "translation"
    },
    "actionPages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "inputMode": {
            "enum": ["selection", "none"],
            "default": "selection"
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "q",
                "w",
                "e",
                "r",
                "t",
                "a",
                "s",
                "d",
                "f",
                "g",
                "z",
                "x",
                "c",
                "v",
                "b"
              ]
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["standard"] },
                    "actionId": {
                      "enum": [
                        "insertIntoWindow",
                        "copyToClipboard",
                        "transformationMenu",
                        "stylingMenu",
                        "chatPromptsMenu",
                        "snippetsMenu",
                        "correction",
                        "translationMenu",
                        "askInChat",
                        "customTransformation",
                        "voiceTransformation"
                      ]
                    }
                  },
                  "required": ["type", "actionId"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["plugin"] },
                    "actionId": {
                      "type": "string",
                      "default": "",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "actionId"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["command"] },
                    "commandId": {
                      "type": "string",
                      "default": "",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "commandId"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["transformation"] },
                    "transformationId": {
                      "type": "string",
                      "default": "",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "transformationId"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["styling"] },
                    "stylingId": {
                      "type": "string",
                      "default": "",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "stylingId"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["translation"] },
                    "language": {
                      "type": "string",
                      "default": "",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "language"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["profileChat"] },
                    "profileId": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type", "profileId"]
                }
              ]
            },
            "default": {}
          }
        },
        "required": ["inputMode", "slots"]
      },
      "defaultPath": "actionPages"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "name": { "type": "string", "default": "" },
          "description": { "type": "string", "default": "" },
          "phrases": {
            "type": "array",
            "items": { "type": "string", "default": "" },
            "default": []
          },
          "toolId": { "type": "string", "default": "", "minLength": 1 },
          "toolConfig": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "isLlmArgumentParsingEnabled": {
            "type": "boolean",
            "default": false
          },
          "isLlmPreTransformEnabled": { "type": "boolean", "default": false },
          "llmPreTransformPrompt": { "type": "string", "default": "" },
          "outputAction": {
            "enum": ["none", "showMenu", "insertIntoWindow", "copyToClipboard"],
            "default": "none"
          },
          "isAvailableExternally": { "type": "boolean", "default": false },
          "externalTimeoutSec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600,
            "default": 120
          },
          "isVoiceEnabled": { "type": "boolean", "default": false },
          "isOutputLogged": { "type": "boolean", "default": false },
          "isEnabled": { "type": "boolean", "default": true },
          "platforms": {
            "type": "array",
            "items": { "enum": ["linux", "windows"] },
            "uniqueItems": true,
            "default": []
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "phrases",
          "toolId",
          "toolConfig",
          "isLlmArgumentParsingEnabled",
          "isLlmPreTransformEnabled",
          "llmPreTransformPrompt",
          "outputAction",
          "isOutputLogged",
          "isAvailableExternally",
          "externalTimeoutSec",
          "isEnabled",
          "isVoiceEnabled"
        ]
      },
      "defaultPath": "commands"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "name": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": { "type": "string", "default": "" }
        },
        "required": ["id", "name", "description"]
      },
      "defaultPath": "variables"
    },
    "variableValues": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      },
      "additionalProperties": { "type": "string", "minLength": 1 },
      "default": {},
      "x-scope": "device"
    },
    "llm": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "default": "",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$",
                    "maxLength": 60
                  },
                  "type": { "enum": ["google", "openrouter", "deepseek"] },
                  "name": { "type": "string", "default": "" }
                },
                "required": ["id", "type"]
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "default": "",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$",
                    "maxLength": 60
                  },
                  "type": { "enum": ["openaiCompatible"] },
                  "name": { "type": "string", "default": "" },
                  "baseUrl": { "type": "string", "default": "" }
                },
                "required": ["id", "type", "baseUrl"]
              }
            ]
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "providerId": { "type": "string", "default": "", "minLength": 1 },
              "providerModelId": { "type": "string", "default": "" },
              "name": { "type": "string", "default": "" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "contextWindowTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canUseImages": { "type": "boolean", "default": false },
              "canUseTools": { "type": "boolean", "default": false },
              "isThinkingEnabled": { "type": "boolean", "default": false }
            },
            "required": [
              "id",
              "providerId",
              "providerModelId",
              "canUseImages",
              "canUseTools"
            ]
          },
          "default": []
        },
        "tasks": {
          "type": "object",
          "properties": {
            "chat": {
              "type": "object",
              "properties": { "rule": { "type": "string", "default": "" } },
              "required": ["rule"],
              "default": { "rule": "" }
            },
            "correction": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "" },
                "rule": { "type": "string", "default": "" }
              },
              "required": ["modelId", "rule"],
              "default": { "modelId": "", "rule": "" }
            },
            "translation": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "" },
                "rule": { "type": "string", "default": "" },
                "qualityGateRule": { "type": "string", "default": "" }
              },
              "required": ["modelId", "rule", "qualityGateRule"],
              "default": { "modelId": "", "rule": "", "qualityGateRule": "" }
            },
            "voiceCorrection": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "" },
                "rule": { "type": "string", "default": "" }
              },
              "required": ["modelId", "rule"],
              "default": { "modelId": "", "rule": "" }
            },
            "aiTask": {
              "type": "object",
              "properties": { "modelId": { "type": "string", "default": "" } },
              "required": ["modelId"],
              "default": { "modelId": "" }
            },
            "transformation": {
              "type": "object",
              "properties": { "modelId": { "type": "string", "default": "" } },
              "required": ["modelId"],
              "default": { "modelId": "" }
            },
            "styling": {
              "type": "object",
              "properties": { "modelId": { "type": "string", "default": "" } },
              "required": ["modelId"],
              "default": { "modelId": "" }
            }
          },
          "required": [
            "chat",
            "correction",
            "translation",
            "voiceCorrection",
            "aiTask",
            "transformation",
            "styling"
          ]
        },
        "imageQuality": {
          "enum": ["economy", "balanced", "original"],
          "default": "balanced"
        },
        "webSearch": {
          "type": "object",
          "properties": {
            "fetchMaxCharacters": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 100000
            }
          }
        }
      },
      "required": ["providers", "models", "tasks", "imageQuality"],
      "defaultPath": "llm"
    },
    "transformations": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"]
          },
          "default": []
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": {}
        }
      },
      "required": ["items", "slots"],
      "defaultPath": "transformations"
    },
    "styling": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"]
          },
          "default": []
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": {}
        }
      },
      "required": ["items", "slots"],
      "defaultPath": "styling"
    },
    "chatPrompts": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
