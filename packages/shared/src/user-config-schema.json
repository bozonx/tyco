{
  "type": "object",
  "properties": {
    "submitKey": { "enum": ["enter", "ctrlEnter"], "defaultPath": "submitKey" },
    "quickCorrectionPrefetch": {
      "type": "boolean",
      "defaultPath": "quickCorrectionPrefetch"
    },
    "quickHideOnBlur": { "type": "boolean", "defaultPath": "quickHideOnBlur" },
    "theme": {
      "enum": ["auto", "light", "dark", "e-ink"],
      "defaultPath": "theme"
    },
    "contrast": {
      "enum": ["auto", "normal", "more"],
      "defaultPath": "contrast"
    },
    "motion": { "enum": ["auto", "normal", "reduce"], "defaultPath": "motion" },
    "uiScale": {
      "enum": [100, 115, 130, 150, 175, 200],
      "defaultPath": "uiScale"
    },
    "appLanguage": { "type": "string", "defaultPath": "appLanguage" },
    "userLanguage": { "type": "string", "defaultPath": "userLanguage" },
    "editorHistoryStorage": {
      "enum": ["off", "session", "disk"],
      "defaultPath": "editorHistoryStorage"
    },
    "editorHistoryMaxItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "editorHistoryMaxItems"
    },
    "editorHistoryRetentionDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "editorHistoryRetentionDays"
    },
    "sanitizeSecretsInEditorHistory": {
      "type": "boolean",
      "defaultPath": "sanitizeSecretsInEditorHistory"
    },
    "chatImageQuality": {
      "enum": ["economy", "balanced", "original"],
      "defaultPath": "chatImageQuality"
    },
    "chatHistoryEnabled": {
      "type": "boolean",
      "defaultPath": "chatHistoryEnabled"
    },
    "chatHistoryRetentionDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "chatHistoryRetentionDays"
    },
    "selectedSttModelId": {
      "type": "string",
      "defaultPath": "selectedSttModelId"
    },
    "diffViewMode": {
      "enum": ["unified", "split", "result"],
      "defaultPath": "diffViewMode"
    },
    "translationViewMode": {
      "enum": ["split", "result"],
      "defaultPath": "translationViewMode"
    },
    "configVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "configVersion"
    },
    "hotkeys": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": { "type": "string", "default": "" },
      "defaultPath": "hotkeys"
    },
    "selectionHotkeys": {
      "type": "object",
      "properties": { "correction": { "type": "string", "default": "" } },
      "required": [],
      "additionalProperties": false,
      "defaultPath": "selectionHotkeys"
    },
    "externalAccess": {
      "type": "object",
      "properties": { "selection": { "type": "boolean", "default": false } },
      "required": ["selection"],
      "additionalProperties": false,
      "defaultPath": "externalAccess"
    },
    "windowInsertion": {
      "type": "object",
      "properties": {
        "method": { "enum": ["xdotool", "ydotool"], "default": "xdotool" },
        "xdotoolBin": { "type": "string", "default": "" },
        "ydotoolBin": { "type": "string", "default": "" },
        "pasteShortcut": {
          "enum": ["ctrl+v", "ctrl+shift+v", "shift+insert"],
          "default": "ctrl+v"
        }
      },
      "required": ["method", "xdotoolBin", "ydotoolBin", "pasteShortcut"],
      "additionalProperties": false,
      "defaultPath": "windowInsertion"
    },
    "toTranslateLanguages": {
      "type": "array",
      "items": {
        "anyOf": [{ "type": "string", "default": "" }, { "type": "null" }],
        "default": null
      },
      "defaultPath": "toTranslateLanguages"
    },
    "mainActions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["standard"] },
              "actionId": {
                "enum": [
                  "insertIntoWindow",
                  "copyToClipboard",
                  "aiTask",
                  "correction",
                  "translation",
                  "askInChat"
                ],
                "default": "insertIntoWindow"
              }
            },
            "required": ["type", "actionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["plugin"] },
              "actionId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "actionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["command"] },
              "commandId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "commandId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["aiTask"] },
              "taskId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "taskId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["translation"] },
              "language": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "language"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["launcherPage"] },
              "page": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "default": 0
              }
            },
            "required": ["type", "page"],
            "additionalProperties": false
          },
          { "type": "null" }
        ]
      },
      "defaultPath": "mainActions"
    },
    "launcherCommands": {
      "type": "array",
      "items": {
        "anyOf": [{ "type": "string", "default": "" }, { "type": "null" }],
        "default": null
      },
      "defaultPath": "launcherCommands"
    },
    "launcherPages": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [{ "type": "string", "default": "" }, { "type": "null" }],
          "default": null
        },
        "default": []
      },
      "defaultPath": "launcherPages"
    },
    "launcherPagesWithoutText": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "default": 0
      },
      "uniqueItems": true,
      "defaultPath": "launcherPagesWithoutText"
    },
    "translation": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["deepl", "google", "llm"], "default": "llm" },
        "qualityGate": {
          "enum": ["off", "on_problems", "always"],
          "default": "off"
        },
        "deeplEndpoint": { "enum": ["free", "pro"], "default": "free" },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string", "default": "", "minLength": 1 },
              "use": { "type": "string", "default": "" },
              "doNotTranslate": { "type": "boolean", "default": false }
            },
            "required": ["term", "use", "doNotTranslate"],
            "additionalProperties": false
          },
          "default": []
        },
        "correctionPrompt": { "type": "string", "default": "" }
      },
      "required": [
        "provider",
        "qualityGate",
        "deeplEndpoint",
        "glossary",
        "correctionPrompt"
      ],
      "additionalProperties": false,
      "defaultPath": "translation"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "default": "", "minLength": 1 },
          "name": { "type": "string", "default": "" },
          "description": { "type": "string", "default": "" },
          "phrases": {
            "type": "array",
            "items": { "type": "string", "default": "" },
            "default": []
          },
          "toolId": { "type": "string", "default": "", "minLength": 1 },
          "toolConfig": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "llmArgumentParsing": { "type": "boolean", "default": false },
          "launcherAfterRun": {
            "type": "object",
            "properties": {
              "action": {
                "enum": ["none", "showMenu", "replaceSelection", "copy"],
                "default": "none"
              }
            },
            "required": ["action"],
            "additionalProperties": false
          },
          "logOutput": { "type": "boolean", "default": false },
          "availableIn": {
            "type": "object",
            "properties": {
              "external": { "type": "boolean", "default": false },
              "chat": { "type": "boolean", "default": false }
            },
            "required": ["external", "chat"],
            "additionalProperties": false
          },
          "enabled": { "type": "boolean", "default": true }
        },
        "required": [
          "id",
          "name",
          "phrases",
          "toolId",
          "toolConfig",
          "llmArgumentParsing",
          "launcherAfterRun",
          "logOutput",
          "availableIn",
          "enabled"
        ],
        "additionalProperties": false
      },
      "defaultPath": "commands"
    },
    "registrationState": {
      "type": "object",
      "properties": {
        "reviewedMainActionIds": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": [],
          "uniqueItems": true
        },
        "seededCommandIds": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": [],
          "uniqueItems": true
        },
        "seededToolIds": {
          "type": "array",
          "items": { "type": "string", "default": "" },
          "default": [],
          "uniqueItems": true
        }
      },
      "required": [
        "reviewedMainActionIds",
        "seededCommandIds",
        "seededToolIds"
      ],
      "additionalProperties": false,
      "defaultPath": "registrationState"
    },
    "llm": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "maxLength": 64
              },
              "type": {
                "enum": [
                  "google",
                  "openrouter",
                  "deepseek",
                  "openai-compatible"
                ],
                "default": "google"
              },
              "name": { "type": "string", "default": "" },
              "baseUrl": { "type": "string", "default": "" }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "default": "", "minLength": 1 },
              "providerId": { "type": "string", "default": "", "minLength": 1 },
              "providerModelId": { "type": "string", "default": "" },
              "name": { "type": "string", "default": "" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "contextWindowTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canUseImages": { "type": "boolean", "default": false },
              "isThinkingEnabled": { "type": "boolean", "default": false }
            },
            "required": ["id", "providerId", "providerModelId"],
            "additionalProperties": false
          },
          "default": []
        },
        "tasks": {
          "type": "object",
          "properties": {
            "translate": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "voiceCorrection": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "correction": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "aiTasks": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            }
          },
          "required": ["translate", "voiceCorrection", "correction", "aiTasks"],
          "additionalProperties": false
        }
      },
      "required": ["providers", "models", "tasks"],
      "additionalProperties": false,
      "defaultPath": "llm"
    },
    "sttModels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "default": "", "minLength": 1 },
          "providerModelId": { "type": "string", "default": "" },
          "provider": {
            "enum": ["deepgram", "sherpa-onnx"],
            "default": "deepgram"
          },
          "description": { "type": "string", "default": "" },
          "formatWithLlm": { "type": "boolean", "default": false },
          "language": { "type": "string", "default": "" },
          "baseUrl": { "type": "string", "default": "" }
        },
        "required": ["id", "providerModelId", "provider"],
        "additionalProperties": false
      },
      "defaultPath": "sttModels"
    },
    "aiRules": {
      "type": "object",
      "properties": {
        "chat": { "type": "string", "default": "" },
        "correction": { "type": "string", "default": "" },
        "translate": { "type": "string", "default": "" },
        "voiceCorrection": { "type": "string", "default": "" }
      },
      "required": ["chat", "correction", "translate", "voiceCorrection"],
      "additionalProperties": false,
      "defaultPath": "aiRules"
    },
    "aiTasks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": { "type": "string", "default": "", "minLength": 1 },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"],
            "additionalProperties": false
          },
          { "type": "null" }
        ],
        "default": null
      },
      "defaultPath": "aiTasks"
    },
    "plugins": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true,
      "defaultPath": "plugins"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "bullet": { "enum": ["-", "*", "+"], "default": "-" },
        "emphasis": { "enum": ["*", "_"], "default": "*" },
        "strong": { "enum": ["*", "_"], "default": "*" },
        "headingStyle": { "enum": ["atx", "setext"], "default": "atx" },
        "incrementListMarker": { "type": "boolean", "default": true }
      },
      "required": [
        "bullet",
        "emphasis",
        "strong",
        "headingStyle",
        "incrementListMarker"
      ],
      "additionalProperties": false,
      "defaultPath": "markdown"
    },
    "markdownClean": {
      "type": "object",
      "properties": {
        "bullet": { "enum": ["-", "*", "none"], "default": "-" },
        "codeBlockIndent": {
          "enum": ["none", "2spaces", "4spaces", "tab"],
          "default": "none"
        },
        "blockquoteIndent": {
          "enum": ["none", "2spaces", "4spaces", "tab", "angle"],
          "default": "none"
        },
        "keepInlineCode": { "type": "boolean", "default": false },
        "linkFormat": {
          "enum": ["text", "textAndUrl", "url"],
          "default": "text"
        },
        "imageFormat": {
          "enum": ["alt", "altAndUrl", "url", "none"],
          "default": "alt"
        },
        "keepThematicBreaks": { "type": "boolean", "default": false },
        "keepTaskCheckboxes": { "type": "boolean", "default": false }
      },
      "required": [
        "bullet",
        "codeBlockIndent",
        "blockquoteIndent",
        "keepInlineCode",
        "linkFormat",
        "imageFormat",
        "keepThematicBreaks",
        "keepTaskCheckboxes"
      ],
      "additionalProperties": false,
      "defaultPath": "markdownClean"
    }
  },
  "required": [
    "externalAccess",
    "hotkeys",
    "selectionHotkeys",
    "submitKey",
    "quickCorrectionPrefetch",
    "quickHideOnBlur",
    "theme",
    "contrast",
    "motion",
    "uiScale",
    "windowInsertion",
    "appLanguage",
    "userLanguage",
    "toTranslateLanguages",
    "translation",
    "mainActions",
    "launcherCommands",
    "commands",
    "editorHistoryStorage",
    "editorHistoryMaxItems",
    "editorHistoryRetentionDays",
    "sanitizeSecretsInEditorHistory",
    "chatImageQuality",
    "chatHistoryEnabled",
    "chatHistoryRetentionDays",
    "llm",
    "sttModels",
    "aiRules",
    "aiTasks",
    "markdown",
    "markdownClean",
    "plugins",
    "selectedSttModelId",
    "registrationState",
    "diffViewMode",
    "translationViewMode",
    "configVersion"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyco user configuration",
  "$defs": {
    "scriptToolConfig": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "default": "" },
        "workingDir": { "type": "string", "default": "" },
        "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "webhookToolConfig": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "default": "" },
        "method": { "enum": ["GET", "POST"], "default": "POST" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "payloadTemplate": { "type": "string", "default": "" },
        "authSecret": { "type": "boolean", "default": false },
        "authSecretId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    }
  }
}
