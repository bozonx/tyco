{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyco user configuration",
  "type": "object",
  "properties": {
    "isInDevelopment": { "type": "boolean" },
    "configVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "configVersion"
    },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": ["auto", "light", "dark", "eInk"],
          "default": "auto"
        },
        "contrast": { "enum": ["auto", "normal", "more"], "default": "auto" },
        "motion": { "enum": ["auto", "normal", "reduce"], "default": "auto" },
        "uiScalePercent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 300,
          "default": 100
        }
      },
      "required": ["theme", "contrast", "motion", "uiScalePercent"],
      "defaultPath": "appearance"
    },
    "language": {
      "type": "object",
      "properties": {
        "ui": { "type": "string", "default": "auto", "minLength": 1 }
      },
      "required": ["ui"],
      "additionalProperties": false,
      "defaultPath": "language"
    },
    "editor": {
      "type": "object",
      "properties": {
        "submitKey": { "enum": ["Enter", "Ctrl+Enter"], "default": "Enter" },
        "diffViewMode": {
          "enum": ["unified", "split", "result"],
          "default": "unified"
        },
        "history": {
          "type": "object",
          "properties": {
            "storage": {
              "enum": ["off", "session", "disk"],
              "default": "disk"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1000
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "isSecretSanitizingEnabled": { "type": "boolean", "default": true }
          },
          "required": ["storage", "maxItems", "isSecretSanitizingEnabled"],
          "default": {
            "storage": "disk",
            "maxItems": 1000,
            "retentionDays": 30,
            "isSecretSanitizingEnabled": true
          }
        }
      },
      "required": ["submitKey", "diffViewMode", "history"],
      "defaultPath": "editor"
    },
    "quickWindow": {
      "type": "object",
      "properties": {
        "isHiddenOnBlur": { "type": "boolean", "default": true },
        "isCorrectionPrefetchEnabled": { "type": "boolean", "default": false }
      },
      "required": ["isHiddenOnBlur", "isCorrectionPrefetchEnabled"],
      "defaultPath": "quickWindow"
    },
    "hotkeys": {
      "type": "object",
      "properties": {
        "editor": { "type": "string", "default": "" },
        "quickInput": { "type": "string", "default": "Ctrl+Alt+Shift+W" },
        "chat": { "type": "string", "default": "" },
        "voiceChat": { "type": "string", "default": "" },
        "voice": { "type": "string", "default": "Ctrl+Alt+Shift+V" },
        "selectionActions": { "type": "string", "default": "Ctrl+Alt+Shift+S" },
        "aiTasks": { "type": "string", "default": "" },
        "correction": { "type": "string", "default": "" },
        "translation": { "type": "string", "default": "" },
        "styling": { "type": "string", "default": "" },
        "transformation": { "type": "string", "default": "" },
        "voiceCommands": { "type": "string", "default": "Ctrl+Alt+Shift+X" },
        "selectionCorrection": {
          "type": "string",
          "default": "Ctrl+Alt+Shift+F"
        }
      },
      "required": [
        "editor",
        "quickInput",
        "chat",
        "voiceChat",
        "voice",
        "selectionActions",
        "aiTasks",
        "correction",
        "translation",
        "styling",
        "transformation",
        "voiceCommands",
        "selectionCorrection"
      ],
      "defaultPath": "hotkeys"
    },
    "externalAccess": {
      "type": "object",
      "properties": {
        "canAccessSelection": { "type": "boolean", "default": false }
      },
      "required": ["canAccessSelection"],
      "defaultPath": "externalAccess"
    },
    "windowInsertion": {
      "type": "object",
      "properties": {
        "linux": {
          "type": "object",
          "properties": {
            "pasteShortcut": {
              "enum": ["Ctrl+V", "Ctrl+Shift+V", "Shift+Insert"],
              "default": "Ctrl+V"
            },
            "terminalPasteShortcut": {
              "enum": [null, "Ctrl+V", "Ctrl+Shift+V", "Shift+Insert"],
              "default": "Ctrl+Shift+V"
            }
          },
          "required": ["pasteShortcut", "terminalPasteShortcut"],
          "additionalProperties": false,
          "default": {
            "pasteShortcut": "Ctrl+V",
            "terminalPasteShortcut": "Ctrl+Shift+V"
          }
        }
      },
      "required": ["linux"],
      "defaultPath": "windowInsertion"
    },
    "translation": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["deepl", "google", "llm"], "default": "llm" },
        "providers": {
          "type": "object",
          "properties": {
            "deepl": {
              "type": "object",
              "properties": {
                "endpoint": { "enum": ["free", "pro"], "default": "free" }
              },
              "required": ["endpoint"],
              "default": { "endpoint": "free" }
            }
          },
          "required": ["deepl"],
          "default": { "deepl": { "endpoint": "free" } }
        },
        "qualityGate": {
          "enum": ["off", "onProblems", "always"],
          "default": "off"
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string", "default": "", "minLength": 1 },
              "translation": { "type": "string", "default": "" },
              "translations": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                },
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["term", "translation"]
          },
          "default": []
        },
        "targetLanguages": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": { "q": "en-US" }
        },
        "viewMode": { "enum": ["split", "result"], "default": "split" }
      },
      "required": [
        "provider",
        "providers",
        "qualityGate",
        "glossary",
        "targetLanguages",
        "viewMode"
      ],
      "defaultPath": "translation"
    },
    "mainActions": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "q",
          "w",
          "e",
          "r",
          "t",
          "a",
          "s",
          "d",
          "f",
          "g",
          "z",
          "x",
          "c",
          "v",
          "b"
        ]
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["standard"] },
              "actionId": {
                "enum": [
                  "insertIntoWindow",
                  "copyToClipboard",
                  "aiTaskMenu",
                  "transformationMenu",
                  "stylingMenu",
                  "correction",
                  "translationMenu",
                  "askInChat"
                ]
              }
            },
            "required": ["type", "actionId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["plugin"] },
              "actionId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "actionId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["command"] },
              "commandId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "commandId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["aiTask"] },
              "taskId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "taskId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["transformation"] },
              "transformationId": {
                "type": "string",
                "default": "",
                "minLength": 1
              }
            },
            "required": ["type", "transformationId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["styling"] },
              "stylingId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "stylingId"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["translation"] },
              "language": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "language"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["launcherPage"] },
              "pageId": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "pageId"]
          }
        ]
      },
      "defaultPath": "mainActions"
    },
    "launcherPages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "q",
                "w",
                "e",
                "r",
                "t",
                "a",
                "s",
                "d",
                "f",
                "g",
                "z",
                "x",
                "c",
                "v",
                "b"
              ]
            },
            "additionalProperties": { "type": "string", "minLength": 1 },
            "default": {}
          },
          "inputMode": {
            "enum": ["selection", "none"],
            "default": "selection"
          },
          "hotkey": { "type": "string", "default": "" }
        },
        "required": ["id", "inputMode", "hotkey", "slots"]
      },
      "defaultPath": "launcherPages"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "name": { "type": "string", "default": "" },
          "description": { "type": "string", "default": "" },
          "phrases": {
            "type": "array",
            "items": { "type": "string", "default": "" },
            "default": []
          },
          "toolId": { "type": "string", "default": "", "minLength": 1 },
          "toolConfig": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "isLlmArgumentParsingEnabled": {
            "type": "boolean",
            "default": false
          },
          "isLlmPreTransformEnabled": { "type": "boolean", "default": false },
          "llmPreTransformPrompt": { "type": "string", "default": "" },
          "outputAction": {
            "enum": ["none", "showMenu", "insertIntoWindow", "copyToClipboard"],
            "default": "none"
          },
          "isAvailableExternally": { "type": "boolean", "default": false },
          "isVoiceEnabled": { "type": "boolean", "default": false },
          "isOutputLogged": { "type": "boolean", "default": false },
          "isEnabled": { "type": "boolean", "default": true }
        },
        "required": [
          "id",
          "name",
          "description",
          "phrases",
          "toolId",
          "toolConfig",
          "isLlmArgumentParsingEnabled",
          "isLlmPreTransformEnabled",
          "llmPreTransformPrompt",
          "outputAction",
          "isOutputLogged",
          "isAvailableExternally",
          "isEnabled",
          "isVoiceEnabled"
        ]
      },
      "defaultPath": "commands"
    },
    "llm": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "default": "",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$",
                    "maxLength": 60
                  },
                  "type": { "enum": ["google", "openrouter", "deepseek"] },
                  "name": { "type": "string", "default": "" }
                },
                "required": ["id", "type"]
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "default": "",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$",
                    "maxLength": 60
                  },
                  "type": { "enum": ["openaiCompatible"] },
                  "name": { "type": "string", "default": "" },
                  "baseUrl": { "type": "string", "default": "" }
                },
                "required": ["id", "type", "baseUrl"]
              }
            ]
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "providerId": { "type": "string", "default": "", "minLength": 1 },
              "providerModelId": { "type": "string", "default": "" },
              "name": { "type": "string", "default": "" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "contextWindowTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canUseImages": { "type": "boolean", "default": false },
              "canUseTools": { "type": "boolean", "default": false },
              "isThinkingEnabled": { "type": "boolean", "default": false }
            },
            "required": [
              "id",
              "providerId",
              "providerModelId",
              "canUseImages",
              "canUseTools"
            ]
          },
          "default": []
        },
        "tasks": {
          "type": "object",
          "properties": {
            "chat": {
              "type": "object",
              "properties": { "rule": { "type": "string", "default": "" } },
              "required": ["rule"],
              "default": { "rule": "" }
            },
            "correction": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "" },
                "rule": { "type": "string", "default": "" }
              },
              "required": ["modelId", "rule"],
              "default": { "modelId": "", "rule": "" }
            },
            "translation": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "" },
                "rule": { "type": "string", "default": "" },
                "qualityGateRule": { "type": "string", "default": "" }
              },
              "required": ["modelId", "rule", "qualityGateRule"],
              "default": { "modelId": "", "rule": "", "qualityGateRule": "" }
            },
            "voiceCorrection": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "" },
                "rule": { "type": "string", "default": "" }
              },
              "required": ["modelId", "rule"],
              "default": { "modelId": "", "rule": "" }
            },
            "aiTask": {
              "type": "object",
              "properties": { "modelId": { "type": "string", "default": "" } },
              "required": ["modelId"],
              "default": { "modelId": "" }
            },
            "transformation": {
              "type": "object",
              "properties": { "modelId": { "type": "string", "default": "" } },
              "required": ["modelId"],
              "default": { "modelId": "" }
            },
            "styling": {
              "type": "object",
              "properties": { "modelId": { "type": "string", "default": "" } },
              "required": ["modelId"],
              "default": { "modelId": "" }
            }
          },
          "required": [
            "chat",
            "correction",
            "translation",
            "voiceCorrection",
            "aiTask",
            "transformation",
            "styling"
          ]
        },
        "imageQuality": {
          "enum": ["economy", "balanced", "original"],
          "default": "balanced"
        }
      },
      "required": ["providers", "models", "tasks", "imageQuality"],
      "defaultPath": "llm"
    },
    "aiTasks": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"]
          },
          "default": []
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": {}
        }
      },
      "required": ["items", "slots"],
      "defaultPath": "aiTasks"
    },
    "transformations": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"]
          },
          "default": []
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": {}
        }
      },
      "required": ["items", "slots"],
      "defaultPath": "transformations"
    },
    "styling": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": { "type": "string", "default": "" },
              "rule": { "type": "string", "default": "" }
            },
            "required": ["id", "name", "rule"]
          },
          "default": []
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": {}
        }
      },
      "required": ["items", "slots"],
      "defaultPath": "styling"
    },
    "aiVault": {
      "type": "object",
      "properties": { "path": { "type": "string", "default": "" } },
      "required": ["path"],
      "defaultPath": "aiVault"
    },
    "aiProfiles": {
      "type": "object",
      "properties": {
        "chatHistory": {
          "type": "object",
          "properties": {
            "storage": { "enum": ["off", "disk"], "default": "disk" },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["storage"],
          "default": { "storage": "disk" }
        }
      },
      "required": ["chatHistory"],
      "defaultPath": "aiProfiles"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "format": {
          "type": "object",
          "properties": {
            "bullet": { "enum": ["-", "*", "+"], "default": "-" },
            "emphasis": { "enum": ["*", "_"], "default": "*" },
            "strong": { "enum": ["*", "_"], "default": "*" },
            "headingStyle": { "enum": ["atx", "setext"], "default": "atx" },
            "isListMarkerIncremented": { "type": "boolean", "default": true }
          },
          "required": [
            "bullet",
            "emphasis",
            "strong",
            "headingStyle",
            "isListMarkerIncremented"
          ],
          "default": {
            "bullet": "-",
            "emphasis": "*",
            "strong": "*",
            "headingStyle": "atx",
            "isListMarkerIncremented": true
          }
        },
        "strip": {
          "type": "object",
          "properties": {
            "bullet": { "enum": ["-", "*", "none"], "default": "-" },
            "codeBlockIndent": {
              "enum": ["none", "twoSpaces", "fourSpaces", "tab"],
              "default": "none"
            },
            "blockquoteIndent": {
              "enum": ["none", "twoSpaces", "fourSpaces", "tab", "angle"],
              "default": "none"
            },
            "hasInlineCode": { "type": "boolean", "default": false },
            "linkFormat": {
              "enum": ["text", "textAndUrl", "url"],
              "default": "text"
            },
            "imageFormat": {
              "enum": ["alt", "altAndUrl", "url", "none"],
              "default": "alt"
            },
            "hasThematicBreaks": { "type": "boolean", "default": true },
            "hasTaskCheckboxes": { "type": "boolean", "default": true }
          },
          "required": [
            "bullet",
            "codeBlockIndent",
            "blockquoteIndent",
            "hasInlineCode",
            "linkFormat",
            "imageFormat",
            "hasThematicBreaks",
            "hasTaskCheckboxes"
          ],
          "default": {
            "bullet": "-",
            "codeBlockIndent": "none",
            "blockquoteIndent": "none",
            "hasInlineCode": false,
            "linkFormat": "text",
            "imageFormat": "alt",
            "hasThematicBreaks": true,
            "hasTaskCheckboxes": true
          }
        }
      },
      "required": ["format", "strip"],
      "defaultPath": "markdown"
    },
    "plugins": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "settingsVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "isEnabled": { "type": "boolean", "default": false },
          "settings": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true,
            "default": {}
          }
        },
        "required": ["isEnabled", "settings"],
        "default": { "isEnabled": false, "settings": {} }
      },
      "defaultPath": "plugins"
    },
    "chat": {
      "type": "object",
      "properties": {
        "history": {
          "type": "object",
          "properties": {
            "storage": { "enum": ["off", "disk"], "default": "disk" },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["storage"],
          "default": { "storage": "disk" }
        }
      },
      "required": ["history"],
      "defaultPath": "chat"
    },
    "stt": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": ["deepgram", "sherpaOnnx"],
          "default": "deepgram"
        },
        "isVoiceCorrectionEnabled": { "type": "boolean", "default": false },
        "isStylingBarEnabled": { "type": "boolean", "default": false },
        "providers": {
          "type": "object",
          "properties": {
            "deepgram": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "nova-3" },
                "language": { "type": "string", "default": "auto" }
              },
              "required": ["modelId", "language"],
              "default": { "modelId": "nova-3", "language": "auto" }
            },
            "sherpaOnnx": {
              "type": "object",
              "properties": {
                "baseUrl": {
                  "type": "string",
                  "default": "ws://localhost:6006"
                }
              },
              "required": ["baseUrl"],
              "default": { "baseUrl": "ws://localhost:6006" }
            }
          },
          "required": ["deepgram", "sherpaOnnx"],
          "default": {
            "deepgram": { "modelId": "nova-3", "language": "auto" },
            "sherpaOnnx": { "baseUrl": "ws://localhost:6006" }
          }
        }
      },
      "required": [
        "provider",
        "isVoiceCorrectionEnabled",
        "isStylingBarEnabled",
        "providers"
      ],
      "defaultPath": "stt"
    }
  },
  "required": [
    "configVersion",
    "appearance",
    "language",
    "editor",
    "quickWindow",
    "hotkeys",
    "externalAccess",
    "windowInsertion",
    "translation",
    "mainActions",
    "launcherPages",
    "commands",
    "llm",
    "aiTasks",
    "transformations",
    "styling",
    "markdown",
    "plugins",
    "chat",
    "stt",
    "aiVault",
    "aiProfiles"
  ],
  "$defs": {
    "scriptToolConfig": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "default": "" },
        "workingDirectory": { "type": "string", "default": "" },
        "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "required": ["command"]
    },
    "webhookToolConfig": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "default": "" },
        "method": { "enum": ["GET", "POST"], "default": "POST" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "payloadTemplate": { "type": "string", "default": "" },
        "isAuthEnabled": { "type": "boolean", "default": false },
        "authSecretId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      },
      "required": ["url"]
    }
  }
