{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyco user configuration",
  "type": "object",
  "properties": {
    "configVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "defaultPath": "configVersion"
    },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": ["auto", "light", "dark", "e-ink"],
          "default": "auto"
        },
        "contrast": { "enum": ["auto", "normal", "more"], "default": "auto" },
        "motion": { "enum": ["auto", "normal", "reduce"], "default": "auto" },
        "uiScalePercent": {
          "enum": [100, 115, 130, 150, 175, 200],
          "default": 100
        }
      },
      "required": ["theme", "contrast", "motion", "uiScalePercent"],
      "additionalProperties": false,
      "defaultPath": "appearance"
    },
    "language": {
      "type": "object",
      "properties": {
        "ui": { "type": "string", "default": "auto" },
        "user": { "type": "string", "default": "auto" }
      },
      "required": ["ui", "user"],
      "additionalProperties": false,
      "defaultPath": "language"
    },
    "editor": {
      "type": "object",
      "properties": {
        "submitKey": { "enum": ["enter", "ctrlEnter"], "default": "enter" },
        "diffViewMode": {
          "enum": ["unified", "split", "result"],
          "default": "unified"
        }
      },
      "required": ["submitKey", "diffViewMode"],
      "additionalProperties": false,
      "defaultPath": "editor"
    },
    "quickWindow": {
      "type": "object",
      "properties": {
        "isHiddenOnBlur": { "type": "boolean", "default": true },
        "isCorrectionPrefetchEnabled": { "type": "boolean", "default": false }
      },
      "required": ["isHiddenOnBlur", "isCorrectionPrefetchEnabled"],
      "additionalProperties": false,
      "defaultPath": "quickWindow"
    },
    "hotkeys": {
      "type": "object",
      "properties": {
        "editor": { "type": "string", "default": "" },
        "write": { "type": "string", "default": "" },
        "chat": { "type": "string", "default": "" },
        "voiceChat": { "type": "string", "default": "" },
        "voice": { "type": "string", "default": "Ctrl+Alt+V" },
        "select": { "type": "string", "default": "Ctrl+Alt+S" },
        "aiTasks": { "type": "string", "default": "" },
        "correction": { "type": "string", "default": "" },
        "translate": { "type": "string", "default": "" },
        "voiceCommands": { "type": "string", "default": "" },
        "selectionCorrection": { "type": "string", "default": "Ctrl+Alt+F" }
      },
      "required": [
        "editor",
        "write",
        "chat",
        "voiceChat",
        "voice",
        "select",
        "aiTasks",
        "correction",
        "translate",
        "voiceCommands",
        "selectionCorrection"
      ],
      "additionalProperties": false,
      "defaultPath": "hotkeys"
    },
    "externalAccess": {
      "type": "object",
      "properties": {
        "canAccessSelection": { "type": "boolean", "default": false }
      },
      "required": ["canAccessSelection"],
      "additionalProperties": false,
      "defaultPath": "externalAccess"
    },
    "windowInsertion": {
      "type": "object",
      "properties": {
        "pasteShortcut": {
          "enum": ["ctrl+v", "ctrl+shift+v", "shift+insert"],
          "default": "ctrl+v"
        },
        "linux": {
          "type": "object",
          "properties": {
            "method": { "enum": ["xdotool", "ydotool"], "default": "xdotool" },
            "xdotoolPath": { "type": "string", "default": "" },
            "ydotoolPath": { "type": "string", "default": "" }
          },
          "required": ["method", "xdotoolPath", "ydotoolPath"],
          "additionalProperties": false,
          "default": {
            "method": "xdotool",
            "xdotoolPath": "",
            "ydotoolPath": ""
          }
        }
      },
      "required": ["pasteShortcut", "linux"],
      "additionalProperties": false,
      "defaultPath": "windowInsertion"
    },
    "translation": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["deepl", "google", "llm"], "default": "llm" },
        "qualityGate": {
          "enum": ["off", "onProblems", "always"],
          "default": "off"
        },
        "deeplEndpoint": { "enum": ["free", "pro"], "default": "free" },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": { "type": "string", "default": "", "minLength": 1 },
              "use": { "type": "string", "default": "" },
              "doNotTranslate": { "type": "boolean", "default": false }
            },
            "required": ["term", "use", "doNotTranslate"],
            "additionalProperties": false
          },
          "default": []
        },
        "targetLanguages": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "q",
              "w",
              "e",
              "r",
              "t",
              "a",
              "s",
              "d",
              "f",
              "g",
              "z",
              "x",
              "c",
              "v",
              "b"
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "default": { "q": "en_US" }
        },
        "viewMode": { "enum": ["split", "result"], "default": "split" },
        "qualityGatePrompt": { "type": "string", "default": "" }
      },
      "required": [
        "provider",
        "qualityGate",
        "qualityGatePrompt",
        "deeplEndpoint",
        "glossary",
        "targetLanguages",
        "viewMode"
      ],
      "additionalProperties": false,
      "defaultPath": "translation"
    },
    "mainActions": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "q",
          "w",
          "e",
          "r",
          "t",
          "a",
          "s",
          "d",
          "f",
          "g",
          "z",
          "x",
          "c",
          "v",
          "b"
        ]
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["standard"] },
              "actionId": {
                "enum": [
                  "insertIntoWindow",
                  "copyToClipboard",
                  "aiTask",
                  "correction",
                  "translation",
                  "askInChat"
                ]
              }
            },
            "required": ["type", "actionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["plugin"] },
              "actionId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "actionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["command"] },
              "commandId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "commandId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["aiTask"] },
              "taskId": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "taskId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["translation"] },
              "language": { "type": "string", "default": "", "minLength": 1 }
            },
            "required": ["type", "language"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "enum": ["launcherPage"] },
              "pageId": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "pageId"],
            "additionalProperties": false
          }
        ]
      },
      "defaultPath": "mainActions"
    },
    "launcherPages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slots": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "q",
                "w",
                "e",
                "r",
                "t",
                "a",
                "s",
                "d",
                "f",
                "g",
                "z",
                "x",
                "c",
                "v",
                "b"
              ]
            },
            "additionalProperties": { "type": "string", "minLength": 1 },
            "default": {}
          },
          "inputMode": {
            "enum": ["selection", "none"],
            "default": "selection"
          },
          "hotkey": { "type": "string", "default": "" }
        },
        "required": ["id", "inputMode", "hotkey", "slots"],
        "additionalProperties": false
      },
      "defaultPath": "launcherPages"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "default": "", "minLength": 1 },
          "name": { "type": "string", "default": "" },
          "description": { "type": "string", "default": "" },
          "phrases": {
            "type": "array",
            "items": { "type": "string", "default": "" },
            "default": []
          },
          "toolId": { "type": "string", "default": "", "minLength": 1 },
          "toolConfig": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "isLlmArgumentParsingEnabled": {
            "type": "boolean",
            "default": false
          },
          "launcherAfterRun": {
            "type": "object",
            "properties": {
              "action": {
                "enum": ["none", "showMenu", "insertIntoWindow", "copy"],
                "default": "none"
              }
            },
            "required": ["action"],
            "additionalProperties": false
          },
          "availableIn": {
            "type": "object",
            "properties": {
              "external": { "type": "boolean", "default": false },
              "chat": { "type": "boolean", "default": false }
            },
            "required": ["external", "chat"],
            "additionalProperties": false
          },
          "isVoiceEnabled": { "type": "boolean", "default": false },
          "voiceConfirmation": {
            "enum": ["always", "auto"],
            "default": "always"
          },
          "isOutputLogged": { "type": "boolean", "default": false },
          "isEnabled": { "type": "boolean", "default": true }
        },
        "required": [
          "id",
          "name",
          "phrases",
          "toolId",
          "toolConfig",
          "isLlmArgumentParsingEnabled",
          "launcherAfterRun",
          "isOutputLogged",
          "availableIn",
          "isEnabled",
          "isVoiceEnabled",
          "voiceConfirmation"
        ],
        "additionalProperties": false
      },
      "defaultPath": "commands"
    },
    "llm": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "default": "",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "maxLength": 64
              },
              "type": {
                "enum": [
                  "google",
                  "openrouter",
                  "deepseek",
                  "openaiCompatible"
                ],
                "default": "google"
              },
              "name": { "type": "string", "default": "" },
              "baseUrl": { "type": "string", "default": "" }
            },
            "required": ["id", "type"],
            "additionalProperties": false
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "default": "", "minLength": 1 },
              "providerId": { "type": "string", "default": "", "minLength": 1 },
              "providerModelId": { "type": "string", "default": "" },
              "name": { "type": "string", "default": "" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "contextWindowTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canUseImages": { "type": "boolean", "default": false },
              "canUseTools": { "type": "boolean", "default": false },
              "isThinkingEnabled": { "type": "boolean", "default": false }
            },
            "required": ["id", "providerId", "providerModelId"],
            "additionalProperties": false
          },
          "default": []
        },
        "taskModelChains": {
          "type": "object",
          "properties": {
            "translation": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "voiceCorrection": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "correction": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            },
            "aiTask": {
              "type": "array",
              "items": { "type": "string", "default": "" },
              "default": [],
              "uniqueItems": true
            }
          },
          "required": [
            "translation",
            "voiceCorrection",
            "correction",
            "aiTask"
          ],
          "additionalProperties": false
        }
      },
      "required": ["providers", "models", "taskModelChains"],
      "additionalProperties": false,
      "defaultPath": "llm"
    },
    "aiRules": {
      "type": "object",
      "properties": {
        "chat": { "type": "string", "default": "" },
        "correction": { "type": "string", "default": "" },
        "translation": { "type": "string", "default": "" },
        "voiceCorrection": { "type": "string", "default": "" }
      },
      "required": ["chat", "correction", "translation", "voiceCorrection"],
      "additionalProperties": false,
      "defaultPath": "aiRules"
    },
    "aiTasks": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "q",
          "w",
          "e",
          "r",
          "t",
          "a",
          "s",
          "d",
          "f",
          "g",
          "z",
          "x",
          "c",
          "v",
          "b"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "default": "", "minLength": 1 },
          "name": { "type": "string", "default": "" },
          "rule": { "type": "string", "default": "" }
        },
        "required": ["id", "name", "rule"],
        "additionalProperties": false
      },
      "defaultPath": "aiTasks"
    },
    "aiVault": {
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": [],
      "additionalProperties": false,
      "defaultPath": "aiVault"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "bullet": { "enum": ["-", "*", "+"], "default": "-" },
        "emphasis": { "enum": ["*", "_"], "default": "*" },
        "strong": { "enum": ["*", "_"], "default": "*" },
        "headingStyle": { "enum": ["atx", "setext"], "default": "atx" },
        "incrementListMarker": { "type": "boolean", "default": true }
      },
      "required": [
        "bullet",
        "emphasis",
        "strong",
        "headingStyle",
        "incrementListMarker"
      ],
      "additionalProperties": false,
      "defaultPath": "markdown"
    },
    "markdownClean": {
      "type": "object",
      "properties": {
        "bullet": { "enum": ["-", "*", "none"], "default": "-" },
        "codeBlockIndent": {
          "enum": ["none", "2spaces", "4spaces", "tab"],
          "default": "none"
        },
        "blockquoteIndent": {
          "enum": ["none", "2spaces", "4spaces", "tab", "angle"],
          "default": "none"
        },
        "keepInlineCode": { "type": "boolean", "default": false },
        "linkFormat": {
          "enum": ["text", "textAndUrl", "url"],
          "default": "text"
        },
        "imageFormat": {
          "enum": ["alt", "altAndUrl", "url", "none"],
          "default": "alt"
        },
        "keepThematicBreaks": { "type": "boolean", "default": true },
        "keepTaskCheckboxes": { "type": "boolean", "default": true }
      },
      "required": [
        "bullet",
        "codeBlockIndent",
        "blockquoteIndent",
        "keepInlineCode",
        "linkFormat",
        "imageFormat",
        "keepThematicBreaks",
        "keepTaskCheckboxes"
      ],
      "additionalProperties": false,
      "defaultPath": "markdownClean"
    },
    "plugins": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "isEnabled": { "type": "boolean", "default": false },
          "settings": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true,
            "default": {}
          }
        },
        "required": ["isEnabled", "settings"],
        "additionalProperties": false,
        "default": { "isEnabled": false, "settings": {} }
      },
      "defaultPath": "plugins"
    },
    "editorHistory": {
      "type": "object",
      "properties": {
        "storage": { "enum": ["off", "session", "disk"], "default": "disk" },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 1000
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 30
        },
        "isSecretSanitizingEnabled": { "type": "boolean", "default": true }
      },
      "required": [
        "storage",
        "maxItems",
        "retentionDays",
        "isSecretSanitizingEnabled"
      ],
      "additionalProperties": false,
      "defaultPath": "editorHistory"
    },
    "chatHistory": {
      "type": "object",
      "properties": {
        "isEnabled": { "type": "boolean", "default": true },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        }
      },
      "required": ["isEnabled", "retentionDays"],
      "additionalProperties": false,
      "defaultPath": "chatHistory"
    },
    "chat": {
      "type": "object",
      "properties": {
        "imageQuality": {
          "enum": ["economy", "balanced", "original"],
          "default": "balanced"
        }
      },
      "required": ["imageQuality"],
      "additionalProperties": false,
      "defaultPath": "chat"
    },
    "stt": {
      "type": "object",
      "properties": {
        "providerId": {
          "enum": ["deepgram", "sherpaOnnx"],
          "default": "deepgram"
        },
        "isLlmFormattingEnabled": { "type": "boolean", "default": false },
        "providers": {
          "type": "object",
          "properties": {
            "deepgram": {
              "type": "object",
              "properties": {
                "modelId": { "type": "string", "default": "nova-3" },
                "language": { "type": "string", "default": "auto" }
              },
              "required": ["modelId", "language"],
              "additionalProperties": false,
              "default": { "modelId": "nova-3", "language": "auto" }
            },
            "sherpaOnnx": {
              "type": "object",
              "properties": {
                "baseUrl": {
                  "type": "string",
                  "default": "ws://localhost:6006"
                }
              },
              "required": ["baseUrl"],
              "additionalProperties": false,
              "default": { "baseUrl": "ws://localhost:6006" }
            }
          },
          "required": ["deepgram", "sherpaOnnx"],
          "additionalProperties": false,
          "default": {
            "deepgram": { "modelId": "nova-3", "language": "auto" },
            "sherpaOnnx": { "baseUrl": "ws://localhost:6006" }
          }
        }
      },
      "required": ["providerId", "isLlmFormattingEnabled", "providers"],
      "additionalProperties": false,
      "defaultPath": "stt"
    }
  },
  "required": [
    "configVersion",
    "appearance",
    "language",
    "editor",
    "quickWindow",
    "hotkeys",
    "externalAccess",
    "windowInsertion",
    "translation",
    "mainActions",
    "launcherPages",
    "commands",
    "llm",
    "aiRules",
    "aiTasks",
    "markdown",
    "markdownClean",
    "plugins",
    "editorHistory",
    "chatHistory",
    "chat",
    "stt",
    "aiVault"
  ],
  "additionalProperties": false,
  "$defs": {
    "scriptToolConfig": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "default": "" },
        "workingDirectory": { "type": "string", "default": "" },
        "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "webhookToolConfig": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "default": "" },
        "method": { "enum": ["GET", "POST"], "default": "POST" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "payloadTemplate": { "type": "string", "default": "" },
        "isAuthEnabled": { "type": "boolean", "default": false },
        "authSecretId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    }
  }
}
