{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-quick-lab",
  "version": "0.1.0",
  "identifier": "com.tyco.quicklab",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TyCo Quick Lab",
        "width": 760,
        "height": 190,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
