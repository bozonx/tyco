{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-capability",
  "description": "Background jobs and quick window operations",
  "windows": ["quick"],
  "permissions": [
    "core:window:allow-is-focused",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-set-size",
    "allow-answer-external-access",
    "allow-claim-external-job",
    "allow-open-transferred-chat",
    "allow-add-screenshot",
    "allow-retake-screenshot",
    "allow-remove-screenshot",
    "allow-confirm-screenshot-crop",
    "allow-cancel-screenshot-crop",
    "allow-hide-quick-window-on-blur",
    "allow-finish-external-job",
    "allow-finish-selection-run",
    "allow-mark-activation-metric",
    "allow-reveal-quick-window",
    "allow-set-quick-input-region",
    "allow-set-tool-catalog",
    "allow-submit-activation-metric-value"
  ]
}
