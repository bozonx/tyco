{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Configuration, plugin installation and secret management",
  "windows": ["main"],
  "permissions": [
    "allow-apply-hotkey",
    "allow-configure-hotkeys",
    "allow-get-ai-vault-path",
    "allow-get-hotkey-provider-info",
    "allow-get-storage-info",
    "allow-inspect-plugin-package",
    "allow-install-plugin-package",
    "allow-open-folder-in-os",
    "allow-open-storage-location",
    "allow-pick-directory",
    "allow-pick-script-file",
    "allow-rebind-hotkeys",
    "allow-remove-plugin-package",
    "allow-restore-plugin-package",
    "allow-secrets-remove",
    "allow-secrets-set",
    "allow-suspend-hotkeys"
  ]
}
