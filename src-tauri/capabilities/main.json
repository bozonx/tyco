{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Configuration, plugin installation and secret management",
  "windows": ["main"],
  "permissions": [
    "allow-apply-hotkey",
    "allow-clear-profile-chats",
    "allow-configure-hotkeys",
    "allow-delete-ai-profile",
    "allow-delete-ai-project",
    "allow-delete-profile-chat",
    "allow-get-ai-vault-path",
    "allow-get-hotkey-provider-info",
    "allow-get-profile-chat",
    "allow-get-storage-info",
    "allow-inspect-plugin-package",
    "allow-install-plugin-package",
    "allow-list-ai-profiles",
    "allow-list-ai-projects",
    "allow-list-profile-chats",
    "allow-open-folder-in-os",
    "allow-open-storage-location",
    "allow-pick-directory",
    "allow-pick-external-project-folder",
    "allow-pick-script-file",
    "allow-read-profile-soul",
    "allow-rebind-hotkeys",
    "allow-remove-plugin-package",
    "allow-rename-profile-chat",
    "allow-restore-plugin-package",
    "allow-save-ai-profile",
    "allow-save-ai-project",
    "allow-save-profile-chat",
    "allow-search-profile-chats",
    "allow-secrets-remove",
    "allow-secrets-set",
    "allow-suspend-hotkeys",
    "allow-write-profile-soul"
  ]
}
