{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "common-capability",
  "description": "Shared application commands for trusted desktop windows",
  "windows": ["main", "quick"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-activate-mode",
    "allow-append-note",
    "allow-cancel-script-action",
    "allow-check-text-injection",
    "allow-clear-chat-history",
    "allow-clear-editor-history",
    "allow-close-window",
    "allow-copy-text",
    "allow-execute-script-action",
    "allow-get-chat",
    "allow-get-chat-history",
    "allow-get-chat-image",
    "allow-get-editor-history",
    "allow-get-init-params",
    "allow-get-user-config",
    "allow-list-installed-plugins",
    "allow-log-client-message",
    "allow-log-command-run",
    "allow-log-custom-action",
    "allow-net-cancel",
    "allow-net-fetch",
    "allow-net-socket-close",
    "allow-net-socket-open",
    "allow-net-socket-send-binary",
    "allow-net-socket-send-text",
    "allow-notify-desktop",
    "allow-open-action-log",
    "allow-open-in-browser",
    "allow-open-in-browser-and-close",
    "allow-open-main-chat",
    "allow-open-main-editor",
    "allow-patch-local-state",
    "allow-read-chat-file",
    "allow-release-chat-image-undo",
    "allow-remove-from-chat-history",
    "allow-remove-from-editor-history",
    "allow-rename-chat",
    "allow-replace-selection-with-command",
    "allow-restore-editor-history-item",
    "allow-save-chat-history",
    "allow-save-editor-history",
    "allow-save-note",
    "allow-save-user-config",
    "allow-search-chat-history",
    "allow-secrets-status",
    "allow-secrets-vault-state",
    "allow-set-editor-history-result",
    "allow-show-status-overlay",
    "allow-start-voice-capture",
    "allow-stop-voice-capture",
    "allow-store-chat-image",
    "allow-sync-chat-images",
    "allow-type-into-window-and-close"
  ]
}
