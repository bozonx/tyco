{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "common-capability",
  "description": "Shared application commands for trusted desktop windows",
  "windows": ["main", "quick"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-acknowledge-settings-shutdown",
    "allow-activate-mode",
    "allow-cancel-script-action",
    "allow-clear-chats",
    "allow-clear-editor-history",
    "allow-hide-window",
    "allow-copy-text",
    "allow-execute-script-action",
    "allow-get-chat",
    "allow-list-chats",
    "allow-read-chat-image",
    "allow-get-editor-history",
    "allow-get-desktop-state",
    "allow-get-hotkey-provider-info",
    "allow-list-installed-plugins",
    "allow-log-client-message",
    "allow-log-command-run",
    "allow-log-webhook-call",
    "allow-cancel-net-task",
    "allow-start-fetch",
    "allow-acknowledge-fetch-chunk",
    "allow-close-socket",
    "allow-open-socket",
    "allow-send-socket-binary",
    "allow-send-socket-text",
    "allow-show-desktop-notification",
    "allow-open-action-log",
    "allow-open-in-browser",
    "allow-open-in-browser-and-hide",
    "allow-open-main-chat",
    "allow-open-main-editor",
    "allow-patch-session-state",
    "allow-read-dropped-file",
    "allow-release-deleted-chat-images",
    "allow-delete-chat",
    "allow-delete-editor-history-item",
    "allow-rename-chat",
    "allow-replace-selection-with-command",
    "allow-restore-editor-history-item",
    "allow-save-chat",
    "allow-add-editor-history-item",
    "allow-save-user-config",
    "allow-search-chats",
    "allow-get-secret-statuses",
    "allow-get-secret-vault-state",
    "allow-set-editor-history-item-result",
    "allow-show-status-overlay",
    "allow-start-voice-capture",
    "allow-stop-voice-capture",
    "allow-store-chat-image",
    "allow-sync-chat-images",
    "allow-paste-into-target-and-hide",
    "allow-write-plugin-note"
  ]
}
