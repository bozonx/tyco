# Development server
PORT=3000

# Development storage
# Set automatically by scripts/tauri-dev.sh to dev_files/<os>.
# TYCO_DEV_HOME=/absolute/path/to/dev_files/linux

# Activation benchmark
TYCO_ACTIVATION_BENCH=0
# TYCO_METRICS_CSV=activation-metrics.csv
TYCO_METRICS_SOCKET_SUFFIX=
TYCO_BENCH_TYPE_DELAY=100
TYCO_BENCH_TYPE_INTERVAL=25
TYCO_BENCH_SETTLE=700
TYCO_BENCH_IDLE=10000

# Quick-window prototype
LAB_WINDOW=toplevel
LAB_LIFECYCLE=hideshow
LAB_DOM=warm
# LAB_METRICS=quick-window-metrics.csv
LAB_WARMUP=0
LAB_SOCKET_SUFFIX=
LAB_TYPE_DELAY=0
LAB_TYPE_INTERVAL=25
LAB_SETTLE=700
LAB_IDLE=0
