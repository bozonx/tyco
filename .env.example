# Development server
PORT=3000

# Local @bozonx/ai-kit checkout (path from the repository root) used instead
# of the published package by the dev server and tests; builds ignore it.
# TYCO_LOCAL_AI_KIT=../ai-kit

# Development storage
# Set automatically by scripts/tauri-dev.mjs to dev_files/<os>.
# TYCO_DEV_HOME=/absolute/path/to/dev_files/linux

# Quick window
# Show/hide cycles that warm the quick window up at startup; 0 turns it off.
TYCO_QUICK_WARMUP=3
# Keyboard of the layer-shell panel: on-demand, or exclusive-until-focused
# (grabs the keyboard when shown, as in the lab, then returns to on-demand).
TYCO_PANEL_KEYBOARD=on-demand

# Activation benchmark; 1 builds `pnpm tauri:dev` with the `activation-bench` feature
TYCO_ACTIVATION_BENCH=0
# TYCO_METRICS_CSV=activation-metrics.csv
TYCO_METRICS_SOCKET_SUFFIX=
TYCO_BENCH_TYPE_DELAY=100
TYCO_BENCH_TYPE_INTERVAL=25
TYCO_BENCH_SETTLE=700
TYCO_BENCH_IDLE=10000
